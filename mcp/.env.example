# LibreClip MCP server configuration
#
# Copy to .env (or set these in your MCP client config) and fill in values.

# --- Authentication (required for everything except the public discovery tools) ---
# Create a key in your LibreClip account: Settings -> API Keys. Starts with "sk_".
LIBRECLIP_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend selection ---
# Defaults to the official hosted instance. Override for self-hosting.
# LIBRECLIP_API_URL=https://api.libreclip.com
# LIBRECLIP_API_URL=http://localhost:8000

# --- Where downloaded/exported clips are written ---
# Defaults to ./libreclip-downloads (relative to the server's working directory).
# LIBRECLIP_DOWNLOAD_DIR=/absolute/path/to/clips

# --- HTTP timeout for non-download requests, in seconds (default 60) ---
# LIBRECLIP_TIMEOUT=60

# --- Hosted MCP server mode ---
# Local MCP clients usually use stdio. For a hosted endpoint, run SSE:
# LIBRECLIP_MCP_TRANSPORT=sse
# LIBRECLIP_MCP_HOST=0.0.0.0
# LIBRECLIP_MCP_PORT=9100
# LIBRECLIP_MCP_PUBLIC_URL=https://mcp.libreclip.com
# LIBRECLIP_MCP_REQUIRE_BEARER_AUTH=true

# --- Self-hosting auth alternatives (only if you are NOT using an API key) ---
# For a self-hosted backend you can authenticate with a user id directly:
#   * If the backend enforces signing (BACKEND_AUTH_SECRET set), provide both:
# LIBRECLIP_USER_ID=your-user-id
# LIBRECLIP_AUTH_SECRET=the-backend-BACKEND_AUTH_SECRET
#   * If the backend runs with ALLOW_UNSIGNED_BACKEND_AUTH=true, the user id alone is enough:
# LIBRECLIP_USER_ID=your-user-id
